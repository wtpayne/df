#:kivy 1.0

<NavControl>:

  cols:3
  rows:3

  Button:
    id:       btn_nav_top_left
    text:     'A'
    on_press: root.nav("A")

  Button:
    id:       btn_nav_top_centre
    text:     'B'
    on_press: root.nav("B")

  Button:
    id:       btn_nav_top_right
    text:     'C'
    on_press: root.nav("C")

  Button:
    id:       btn_nav_middle_left
    text:     'D'
    on_press: root.nav("D")

  Button:
    id:       btn_nav_middle_centre
    text:     'E'
    on_press: root.nav("E")

  Button:
    id:       btn_nav_middle_right
    text:     'F'
    on_press: root.nav("F")

  Button:
    id:       btn_nav_bottom_left
    text:     'G'
    on_press: root.nav("G")

  Button:
    id:       btn_nav_bottom_centre
    text:     'H'
    on_press: root.nav("H")

  Button:
    id:       btn_nav_bottom_right
    text:     'I'
    on_press: root.nav("I")
